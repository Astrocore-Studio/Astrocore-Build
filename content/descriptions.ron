    ("ClothingUniformJumpsuitParamedic", "It's got a plus on it, that's a good thing right?"),
    ("ClothingUniformJumpsuitPirate", "A pirate variation of a space sailor's jumpsuit."),
    ("ClothingUniformJumpsuitPrisoner", "A jumpsuit used for prisoners. It has suit sensors automatically enabled at all times."),
    ("ClothingUniformJumpsuitQM", "What can brown do for you?"),
    ("ClothingUniformJumpsuitResearchDirector", "It's a turtleneck worn by those with the know-how to achieve the position of Research Director. Its fabric provides minor protection from biological contaminants."),
    ("ClothingUniformJumpsuitRoboticist", "It's a slimming black with reinforced seams; great for industrial work."),
    ("ClothingUniformJumpsuitSalvageSpecialist", "It's a snappy jumpsuit with a sturdy set of overalls. It's very dirty."),
    ("ClothingUniformJumpsuitScientist", "It's made of a special fiber that increases perceived intelligence and decreases personal ethics. It has markings that denote the wearer as a scientist."),
