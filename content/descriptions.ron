    ("ClothingMaskFox", "What does the fox say?"),
    ("ClothingMaskGas", "A face-covering mask that can be connected to an air supply."),
    ("ClothingMaskGasAtmos", "Improved gas mask utilized by atmospheric technicians. It's flameproof!"),
