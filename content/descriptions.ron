    ("VendingMachineDonut", "A donut vendor provided by Robust Industries, LLC."),
    ("VendingMachineDrGibb", "Canned explosion of different flavors in this very vendor!"),
    ("VendingMachineEngiDrobe", "A vending machine renowned for vending industrial grade clothing."),
    ("VendingMachineEngivend", "Spare tool vending. What? Did you expect some witty description?"),
    ("VendingMachineGames", "Vends things that the Captain and Head of Personnel are probably not going to appreciate you fiddling with instead of your job..."),
    ("VendingMachineGeneDrobe", "A machine for dispensing clothing related to genetics."),
