    ("VendingMachineHydrobe", "A machine with a catchy name. It dispenses botany related clothing and gear."),
    ("VendingMachineJaniDrobe", "A self cleaning vending machine capable of dispensing clothing for janitors."),
    ("VendingMachineLawDrobe", "Objection! This wardrobe dispenses the rule of law... and lawyer clothing.."),
    ("VendingMachineMagivend", "A magic vending machine."),
    ("VendingMachineMediDrobe", "A vending machine rumoured to be capable of dispensing clothing for medical personnel."),
    ("VendingMachineMedical", "It's a medical drug dispenser. Natural chemicals only!"),
    ("VendingMachineMedicalBase", "It's a medical drug dispenser. Natural chemicals only!"),
    ("VendingMachineNutri", "A vending machine containing nutritional substances for plants and botanical tools."),
    ("VendingMachinePride", "A vending machine containing pride."),
    ("VendingMachinePwrGame", "You want it, we got it. Brought to you in partnership with Vlad's Salads."),
    ("VendingMachineRestockBooze", "Slot into your Booze-O-Mat to start the party! Not for sale to passengers below the legal age."),
    ("VendingMachineRestockChang", "A box covered in white labels with bold red Chinese characters, ready to be loaded into the nearest Mr. Chang's vending machine."),
    ("VendingMachineRestockCondimentStation", "Refill the condiment station. Mmmm, cold sauce."),
    ("VendingMachineRestockDiscountDans", "A box full of salt and starch. Why suffer Quality when you can have Quantity? Discount Dan's!"),
    ("VendingMachineRestockDonut", "A box full of toroidal bundles of fried dough for restocking a vending machine. Use only as directed by Robust Industries, LLC."),
    ("VendingMachineRestockGetmoreChocolateCorp", "A box loaded with the finest ersatz cacao. Only to be used in official Getmore Chocolate vending machines."),
    ("VendingMachineRestockHappyHonk", "Place this box full of fun into the restock slot on the Happy Honk Dispenser to begin."),
    ("VendingMachineRestockHotDrinks", "Toasty! For use in Solar's Best Hot Drinks or other affiliate vending machines."),
    ("VendingMachineRestockRobustSoftdrinks", "A cold, clunky container of colliding chilly cylinders. Use only as directed by Robust Industries, LLC."),
    ("VendingMachineRoboDrobe", "A vending machine designed to dispense clothing known only to roboticists."),
    ("VendingMachineRobotics", "All the tools you need to create your own robot army."),
    ("VendingMachineSalvage", "A dwarf's best friend!"),
    ("VendingMachineSalvageCargo", "A dwarf's best friend!"),
    ("VendingMachineSciDrobe", "A simple vending machine suitable to dispense well tailored science clothing. Endorsed by Space Cubans."),
