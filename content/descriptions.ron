    ("VendingMachineChapel", "Just add capitalism!"),
    ("VendingMachineChefDrobe", "This vending machine might not dispense meat, but it certainly dispenses chef related clothing."),
    ("VendingMachineChefvend", "An ingredient vendor for all your cheffin needs."),
    ("VendingMachineChemDrobe", "A vending machine for dispensing chemistry related clothing."),
    ("VendingMachineChemicals", "Probably not the coffee machine."),
    ("VendingMachineChemicalsMed", "Probably not the coffee machine."),
    ("VendingMachineChemicalsSyndicate", "Not made with freshly squeezed syndies I hope."),
    ("VendingMachineCigs", "If you want to get cancer, might as well do it in style."),
