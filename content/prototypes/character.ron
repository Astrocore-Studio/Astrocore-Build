// Правила персонажа и виды, как прототипы SS14 (`Species`, cvar `ic.*`). Редактор персонажа и
// проверка профиля читают только их: новый вид или другие пределы — правка этого файла.
[
    // Пределы профиля: слотов на игрока, длина имени и описания (`ic.name_length`, `ic.flavor_text_length`).
    (id: "CharacterRules", components: {
        "CharacterRules": (maxSlots: 5, maxNameLength: 32, maxFlavorLength: 512),
    }),
    // Человек (`Species/human.yml`): возраст, пол, цвет кожи тоном (`HumanToned`), цвета глаз и волос.
    (id: "Human", components: {
        "Species": (
            name: "Human",
            roundStart: true,
            minAge: 18,
            maxAge: 120,
            sexes: ["Male", "Female", "Unsexed"],
            skinColoration: "HumanToned",
            defaultSkinTone: 20.0,
            eyeColors: [
                [44, 30, 20], [74, 47, 26], [59, 110, 58], [58, 95, 158], [106, 140, 168], [112, 112, 112],
            ],
            hairColors: [
                [26, 20, 16], [50, 40, 30], [90, 58, 34], [138, 90, 44], [194, 154, 90], [224, 200, 138], [154, 42, 30],
            ],
        ),
    }),
]
