// Объём надетого на персонажа: на сколько пикселей (32 на метр) слой выступает за тело с каждой
// стороны. Тело — плита в один пиксель. Слои считаются по возрастанию: каждый следующий поверх
// предыдущего, поэтому пояс (2) лежит под верхней одеждой (3). У отдельного предмета поле `shell`
// в компоненте `WornVolume` перекрывает значение слота.
[
    (id: "WornVolumeDefaults", components: {"WornVolume": (slots: {
        "shoes": 1,
        "jumpsuit": 1,
        "gloves": 1,
        "id": 2,
        "belt": 2,
        "outerClothing": 3,
        "back": 3,
        "neck": 2,
        "mask": 1,
        "eyes": 1,
        "ears": 1,
        "head": 1,
        "hand": 1,
    })}),
]
