// Стулья (chairs.rsi SS14): стоячие спрайты без коллизии. Столы, стойки и шкафы — ящики-конструкции,
// их ставит импортёр карт (см. tools/import_map.rs).
[
    // Стол: спрайт лежит горизонтально, объём 20 пикселей (0,625 м). Ящик-конструкцию ставит импортёр.
    (id: "Table", name: Some("table"), components: {
        "Sprite": (sprite: "Structures/Furniture/Tables/generic.rsi", state: "full"),
        "SpriteVolume": (layout: "Flat", height: 20.0),
    }),
    // Стол: спрайт лежит горизонтально, объём 20 пикселей (0,625 м). Ящик-конструкцию ставит импортёр.
    (id: "TableWood", name: Some("wooden table"), components: {
        "Sprite": (sprite: "Structures/Furniture/Tables/wood.rsi", state: "full"),
        "SpriteVolume": (layout: "Flat", height: 20.0),
    }),
    // Стол: спрайт лежит горизонтально, объём 20 пикселей (0,625 м). Ящик-конструкцию ставит импортёр.
    (id: "TableReinforced", name: Some("reinforced table"), components: {
        "Sprite": (sprite: "Structures/Furniture/Tables/reinforced.rsi", state: "full"),
        "SpriteVolume": (layout: "Flat", height: 20.0),
    }),
    // Стол: спрайт лежит горизонтально, объём 20 пикселей (0,625 м). Ящик-конструкцию ставит импортёр.
    (id: "TableGlass", name: Some("glass table"), components: {
        "Sprite": (sprite: "Structures/Furniture/Tables/glass.rsi", state: "full"),
        "SpriteVolume": (layout: "Flat", height: 20.0),
    }),
    (id: "Chair", name: Some("chair"), components: {
        "Sprite": (sprite: "Structures/Furniture/chairs.rsi", state: "chair"),
        "Strap": (buckleDoafterTime: 2.0),
    }),
    (id: "ChairOffice", name: Some("office chair"), components: {
        "Sprite": (sprite: "Structures/Furniture/chairs.rsi", state: "office-dark"),
        "Strap": (buckleDoafterTime: 2.0),
    }),
    (id: "ChairComfy", name: Some("comfy chair"), components: {
        "Sprite": (sprite: "Structures/Furniture/chairs.rsi", state: "comfy"),
        "Strap": (buckleDoafterTime: 2.0),
    }),
    (id: "ChairWooden", name: Some("wooden chair"), components: {
        "Sprite": (sprite: "Structures/Furniture/chairs.rsi", state: "wooden"),
    }),
    (id: "StoolBar", name: Some("stool"), components: {
        "Sprite": (sprite: "Structures/Furniture/chairs.rsi", state: "stool"),
    }),
]
