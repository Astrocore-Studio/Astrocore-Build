[
    (id: "BaseItem", abstract: true, components: {"Item": (size: "Small")}),

    (id: "Crowbar", parents: ["BaseItem"], name: Some("crowbar"), components: {
        "Sprite": (sprite: "Objects/Tools/crowbar.rsi", state: "icon"),
        "Tool": (qualities: ["Prying"]),
        "MeleeWeapon": (damage: (Blunt: 8.0), attackRate: 1.5),
        "Clothing": (slots: ["belt"]),
        "Tag": (tags: ["Crowbar"]),
    }),
    (id: "Wrench", parents: ["BaseItem"], name: Some("wrench"), components: {
        "Sprite": (sprite: "Objects/Tools/wrench.rsi", state: "icon"),
        "Tool": (qualities: ["Anchoring"]),
        "MeleeWeapon": (damage: (Blunt: 4.5), attackRate: 1.5),
        "Clothing": (slots: ["belt"]),
    }),
    (id: "Screwdriver", parents: ["BaseItem"], name: Some("screwdriver"), components: {
        "Sprite": (sprite: "Objects/Tools/screwdriver.rsi", state: "screwdriver"),
        "Tool": (qualities: ["Screwing"]),
        "MeleeWeapon": (damage: (Piercing: 6.0), attackRate: 1.0),
        "Clothing": (slots: ["belt"]),
    }),
    // Сварка: источник огня (`IgnitionSource`, 700 К); `F` в руке зажигает и гасит. Топливо и
    // сварка металла не перенесены.
    (id: "Welder", parents: ["BaseItem"], name: Some("welding tool"), components: {
        "Sprite": (sprite: "Objects/Tools/welder.rsi", state: "icon"),
        "Clothing": (slots: ["belt"]),
        "IgnitionSource": (temperature: 700.0),
        "MeleeWeapon": (damage: (Blunt: 5.0), attackRate: 1.0),
    }),
    // Лечение: значения `Healing` из healing.yml SS14 (одна единица за применение); стопка по 10 применений, как в SS14;
    // задержка по умолчанию 3 с — выбор билда.
    (id: "Brutepack", parents: ["BaseItem"], name: Some("brutepack"), components: {
        "Sprite": (sprite: "Objects/Specific/Medical/medical.rsi", state: "brutepack"),
        "Stack": (stackType: "Brutepack", count: 10),
        "Healing": (damage: (Blunt: -5.0, Piercing: -5.0, Slash: -5.0), delay: 3.0),
    }),
    // Марля: `Gauze` из healing.yml — режет и колет, останавливает кровотечение (`bloodlossModifier`).
    (id: "Gauze", parents: ["BaseItem"], name: Some("roll of gauze"), components: {
        "Sprite": (sprite: "Objects/Specific/Medical/medical.rsi", state: "gauze"),
        "Stack": (stackType: "Gauze", count: 10),
        "Healing": (damage: (Slash: -5.0, Piercing: -10.0), delay: 3.0, bloodlossModifier: -10.0),
    }),
    (id: "Ointment", parents: ["BaseItem"], name: Some("ointment"), components: {
        "Sprite": (sprite: "Objects/Specific/Medical/medical.rsi", state: "ointment"),
        "Stack": (stackType: "Ointment", count: 10),
        "Healing": (damage: (Heat: -5.0, Cold: -5.0, Shock: -5.0), delay: 3.0),
    }),
    // Тело умершего: не предмет (без `Item`), только декорация на месте смерти.
    (id: "Corpse", name: Some("corpse"), components: {
        "Sprite": (sprite: "Mobs/Species/Human/parts.rsi", state: "full"),
    }),
    // Еда и питьё: данные `FoodBurgerPlain` (burger.yml, `FoodBurgerBase`) и `DrinkWaterBottleFull`
    // (drinks_bottles_plastic.yml): состав раствора и спрайты оттуда, `Edible` по умолчанию —
    // укус 5 единиц за 1 с; бутылка закрыта, пока её не откроют, и после опустошения остаётся.
    (id: "FoodBurgerPlain", parents: ["BaseItem"], name: Some("plain burger"), components: {
        "Sprite": (sprite: "Objects/Consumable/Food/burger.rsi", state: "plain"),
        "Edible": (transferAmount: 5.0, delay: 1.0, destroyOnEmpty: true),
        "Solution": (maxVol: 50.0, reagents: (Nutriment: 30.0, Protein: 10.0, Vitamin: 10.0)),
    }),
    (id: "DrinkWaterBottleFull", parents: ["BaseItem"], name: Some("water bottle"), components: {
        "Sprite": (sprite: "Objects/Consumable/Drinks/waterbottle.rsi", state: "icon"),
        "Edible": (transferAmount: 5.0, delay: 1.0, destroyOnEmpty: false),
        "Openable": (opened: false),
        "Solution": (maxVol: 60.0, reagents: (Water: 60.0)),
    }),
    // Бутылка космической смазки для опытов со скольжением: `V` выливает содержимое под ноги.
    (id: "SpaceLubeBottle", parents: ["BaseItem"], name: Some("space lube bottle"), components: {
        "Sprite": (sprite: "Objects/Consumable/Drinks/waterbottle.rsi", state: "icon"),
        "Solution": (maxVol: 60.0, reagents: (SpaceLube: 60.0)),
    }),
    // Уборка (janitor.yml, bucket.yml): швабра хранит до 120 ед. и меняет воду на грязь в луже;
    // клик по луже или по ведру на полу. Ведро на 360 ед.; `BucketWater` — ведро с водой для карты
    // (в SS14 воду берут из раковин и баков, их здесь нет).
    (id: "MopItem", parents: ["BaseItem"], name: Some("mop"), components: {
        "Sprite": (sprite: "Objects/Specific/Janitorial/mop.rsi", state: "mop"),
        "Item": (size: "Large"),
        "Absorbent": (),
        "Solution": (maxVol: 120.0),
        "MeleeWeapon": (damage: (Blunt: 10.0), attackRate: 1.0),
    }),
    (id: "Bucket", parents: ["BaseItem"], name: Some("bucket"), components: {
        "Sprite": (sprite: "Objects/Tools/bucket.rsi", state: "icon"),
        "Item": (size: "Large"),
        "Refillable": (),
        "Solution": (maxVol: 360.0),
    }),
    (id: "BucketWater", parents: ["Bucket"], name: Some("bucket of water"), components: {
        "Solution": (maxVol: 360.0, reagents: (Water: 360.0)),
    }),
    (id: "Pen", name: Some("pen"), components: {
        "Item": (size: "Tiny"),
        "Sprite": (sprite: "Objects/Misc/pens.rsi", state: "pen"),
    }),
    (id: "Box", name: Some("box"), components: {
        "Item": (size: "Normal"),
        "Sprite": (sprite: "Objects/Storage/boxes.rsi", state: "box"),
        "Storage": (grid: ["0,0,3,1"], maxItemSize: "Small"),
    }),
    // Размеры и сетка рюкзака — как в Resources/Prototypes/Entities/Clothing/Back/backpacks.yml.
    (id: "ClothingBackpack", name: Some("backpack"), components: {
        "Item": (size: "Colossal"),
        "Sprite": (sprite: "Clothing/Back/Backpacks/backpack.rsi", state: "icon"),
        // Задержки надевания и снятия — решение билда (в SS14 у рюкзака их нет); задаются в `Clothing`.
        "Clothing": (slots: ["back"], equipDelay: 1.0, unequipDelay: 0.5),
        "Storage": (grid: ["0,0,6,3"], maxItemSize: "Huge", blacklist: (tags: ["TrashBag"])),
    }),
]
