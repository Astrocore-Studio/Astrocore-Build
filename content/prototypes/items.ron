[
    (id: "BaseItem", abstract: true, components: {"Item": (size: "Small")}),

    (id: "Crowbar", parents: ["BaseItem"], name: Some("crowbar"), components: {
        "Sprite": (sprite: "Objects/Tools/crowbar.rsi", state: "icon"),
        "Tool": (qualities: ["Prying"]),
        "MeleeWeapon": (damage: (Blunt: 8.0), attackRate: 1.5),
        "Clothing": (slots: ["belt"]),
        "Tag": (tags: ["Crowbar"]),
    }),
    (id: "Wrench", parents: ["BaseItem"], name: Some("wrench"), components: {
        "Sprite": (sprite: "Objects/Tools/wrench.rsi", state: "icon"),
        "Tool": (qualities: ["Anchoring"]),
        "MeleeWeapon": (damage: (Blunt: 4.5), attackRate: 1.5),
        "Clothing": (slots: ["belt"]),
    }),
    (id: "Screwdriver", parents: ["BaseItem"], name: Some("screwdriver"), components: {
        "Sprite": (sprite: "Objects/Tools/screwdriver.rsi", state: "screwdriver"),
        "Tool": (qualities: ["Screwing"]),
        "MeleeWeapon": (damage: (Piercing: 6.0), attackRate: 1.0),
        "Clothing": (slots: ["belt"]),
    }),
    // Лечение: значения `Healing` из healing.yml SS14 (одна единица за применение); стопка по 10 применений, как в SS14;
    // задержка по умолчанию 3 с — выбор билда.
    (id: "Brutepack", parents: ["BaseItem"], name: Some("brutepack"), components: {
        "Sprite": (sprite: "Objects/Specific/Medical/medical.rsi", state: "brutepack"),
        "Stack": (stackType: "Brutepack", count: 10),
        // `bleedStop` — выбор билда: перевязка снижает кровотечение на единицу за применение.
        "Healing": (damage: (Blunt: -5.0, Piercing: -5.0, Slash: -5.0), delay: 3.0, bleedStop: 1.0),
    }),
    (id: "Ointment", parents: ["BaseItem"], name: Some("ointment"), components: {
        "Sprite": (sprite: "Objects/Specific/Medical/medical.rsi", state: "ointment"),
        "Stack": (stackType: "Ointment", count: 10),
        "Healing": (damage: (Heat: -5.0, Cold: -5.0, Shock: -5.0), delay: 3.0),
    }),
    // Тело умершего: не предмет (без `Item`), только декорация на месте смерти.
    (id: "Corpse", name: Some("corpse"), components: {
        "Sprite": (sprite: "Mobs/Species/Human/parts.rsi", state: "full"),
    }),
    (id: "Pen", name: Some("pen"), components: {
        "Item": (size: "Tiny"),
        "Sprite": (sprite: "Objects/Misc/pens.rsi", state: "pen"),
    }),
    (id: "Box", name: Some("box"), components: {
        "Item": (size: "Normal"),
        "Sprite": (sprite: "Objects/Storage/boxes.rsi", state: "box"),
        "Storage": (grid: ["0,0,3,1"], maxItemSize: "Small"),
    }),
    // Размеры и сетка рюкзака — как в Resources/Prototypes/Entities/Clothing/Back/backpacks.yml.
    (id: "ClothingBackpack", name: Some("backpack"), components: {
        "Item": (size: "Colossal"),
        "Sprite": (sprite: "Clothing/Back/Backpacks/backpack.rsi", state: "icon"),
        // Задержки надевания и снятия — решение билда (в SS14 у рюкзака их нет); задаются в `Clothing`.
        "Clothing": (slots: ["back"], equipDelay: 1.0, unequipDelay: 0.5),
        "Storage": (grid: ["0,0,6,3"], maxItemSize: "Huge", blacklist: (tags: ["TrashBag"])),
    }),
]
