// Электричество (данные из Resources/Prototypes/Entities/Structures/Power SS14). Кабели лежат под
// полом и на карте задаются зонами `power_cable` (`hv`, `mv`, `apc`); см. gameplay/electric.rs.
// Компоненты билда: `PowerSupplier` (источник в сети группы `group`), `PowerBattery` (заряжается из
// сети `from`, отдаёт в сеть `to`; `from: "terminal"` — по ближайшей клемме) и `ApcPowerReceiver`
// (потребитель сети АПЦ, `load` Вт; без поля — 5 Вт, как в SS14).
[
    (id: "GeneratorBasic", name: Some("generator"), components: {
        "Sprite": (sprite: "Structures/Power/power.rsi", state: "generator"),
        "PowerSupplier": (group: "hv", maxSupply: 3000.0, rampRate: 500.0, rampTolerance: 500.0),
    }),
    // Солнечная панель: у SS14 выработка зависит от Солнца; здесь панель всегда даёт 1500 Вт.
    (id: "SolarPanel", name: Some("solar panel"), components: {
        "Sprite": (sprite: "Structures/Power/Generation/solar_panel.rsi", state: "solar_panel_glass"),
        "PowerSupplier": (group: "hv", maxSupply: 1500.0, rampRate: 500.0, rampTolerance: 500.0),
    }),
    (id: "SubstationBasic", name: Some("substation"), components: {
        "Sprite": (sprite: "Structures/Power/substation.rsi", state: "substation"),
        "PowerBattery": (from: "hv", to: "mv", capacity: 2500000.0, startingCharge: 2500000.0, maxChargeRate: 150000.0, maxSupply: 150000.0, rampRate: 1000.0, rampTolerance: 5000.0),
    }),
    (id: "SMESBasic", name: Some("SMES"), components: {
        "Sprite": (sprite: "Structures/Power/smes.rsi", state: "smes"),
        "PowerBattery": (from: "terminal", to: "hv", capacity: 8000000.0, startingCharge: 8000000.0, maxChargeRate: 150000.0, maxSupply: 150000.0, rampRate: 1000.0, rampTolerance: 5000.0),
    }),
    (id: "CableTerminal", name: Some("cable terminal"), components: {
        "Sprite": (sprite: "Structures/Power/cable_terminal.rsi", state: "term"),
        "PowerTerminal": (),
    }),
    (id: "APCBasic", name: Some("APC"), components: {
        "Sprite": (sprite: "Structures/Wallmounts/apc.rsi", state: "base"),
        "PowerBattery": (from: "mv", to: "apc", capacity: 50000.0, startingCharge: 50000.0, maxChargeRate: 5000.0, maxSupply: 10000.0, rampRate: 500.0, rampTolerance: 1000.0),
    }),

    // Светильники (base_lighting.yml, lights.yml): лампа-трубка `LightTube` (#FFE4CE, 0,8, радиус 10) и
    // лампа накаливания `LightBulb` (#FFD1A3, 1,0, радиус 6); потребление 40 Вт. Светильник стоит на
    // потолке; спрайт настенного плафона на полу не рисуется.
    (id: "Poweredlight", name: Some("light"), components: {
        "Light": (color: "#FFE4CE", energy: 0.8, radius: 10.0),
        "ApcPowerReceiver": (load: 40.0),
    }),
    (id: "PoweredSmallLight", name: Some("small light"), components: {
        "Light": (color: "#FFD1A3", energy: 1.0, radius: 6.0),
        "ApcPowerReceiver": (load: 40.0),
    }),
]
