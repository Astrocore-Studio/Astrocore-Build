    (id: "ActionChangelingStingDna", parents: ["BaseAction"], name: Some("Extract DNA"), description: Some("Sneakily absorb the identity of unsuspecting victims. Does not grant DNA to your store or objective progress. \n\nRequires 50 Chemicals.")),
    (id: "ActionChangelingStingHemotoxin", parents: ["BaseActionChangelingSting"], name: Some("Hemotoxin Sting"), description: Some("Sting a target and inject them with a dangerous dose of various toxins, causing extensive bleeding. \n\nRequires 30 Chemicals.")),
    (id: "ActionChangelingStingLead", parents: ["BaseActionChangelingSting"], name: Some("Lethal Sting"), description: Some("Silently sting a target and inject them with a lethal dose of a slow acting poison. \n\nRequires 50 Chemicals.")),
    (id: "ActionChangelingStingMute", parents: ["BaseActionChangelingSting"], name: Some("Mute Sting"), description: Some("Silently sting a target and inject them with chemicals that prevent them from speaking. \n\nRequires 30 Chemicals.")),
